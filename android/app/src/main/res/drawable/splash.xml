<?xml version="1.0" encoding="utf-8"?>
<!-- night-blue boot background (#0a1c2e) with the app icon centred, the same as the Android 12+ splash
     (splash_icon.png: a 192dp round icon on a 288dp canvas, made by scripts/android-icons.mjs) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/kudo_bg"/>
    <item android:drawable="@drawable/splash_icon" android:gravity="center" android:width="288dp" android:height="288dp"/>
</layer-list>
