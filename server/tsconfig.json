{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "test/**/*.ts", "../src/engine", "../src/contracts.ts", "../src/roster.ts", "../src/net/protocol.ts", "../src/net/room"],
  "exclude": ["../src/engine/**/*.test.ts", "../src/engine/testutil.ts"]
}
